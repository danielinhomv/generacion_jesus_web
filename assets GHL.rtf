(() => \{\
  var results = [];\
  \
  // 1. Buscamos todas las im\'e1genes de la p\'e1gina\
  var imgs = Array.from(document.querySelectorAll('img'));\
  \
  // 2. Filtramos \'fanicamente las im\'e1genes que est\'e1n en la carpeta multimedia principal\
  var mediaImgs = imgs.filter(function(img) \{\
    var src = img.src || img.getAttribute('data-src') || '';\
    return (src.indexOf('leadconnectorhq.com') !== -1 || src.indexOf('filesafe.space') !== -1) \
      && src.indexOf('copilot') === -1 \
      && src.indexOf('sidebar') === -1;\
  \});\
\
  // 3. Recorremos cada imagen para obtener su nombre exacto desde la tarjeta\
  mediaImgs.forEach(function(img) \{\
    var url = img.src || img.getAttribute('data-src') || '';\
    \
    // Subimos hasta encontrar el contenedor de la tarjeta que guarda el nombre\
    var card = img.closest('div');\
    var fileName = '';\
    var depth = 0;\
\
    while (card && depth < 8) \{\
      var text = card.innerText ? card.innerText.trim() : '';\
      if (text) \{\
        var lines = text.split('\\n');\
        for (var i = 0; i < lines.length; i++) \{\
          var line = lines[i].trim();\
          // Detectamos la l\'ednea que tiene extensi\'f3n (.svg, .png, etc)\
          if (line.match(/\\.(svg|png|jpg|jpeg|gif|webp)/i)) \{\
            fileName = line;\
            break;\
          \}\
        \}\
      \}\
      if (fileName) break;\
      card = card.parentElement;\
      depth++;\
    \}\
\
    // Si por alguna raz\'f3n no hall\'f3 el texto en la tarjeta, extraemos el nombre de la URL\
    if (!fileName) \{\
      var cleanUrl = url.split('?')[0];\
      fileName = cleanUrl.substring(cleanUrl.lastIndexOf('/') + 1);\
    \}\
\
    results.push(fileName + '\\t' + url);\
  \});\
\
  var textToCopy = results.join('\\n');\
\
  if (results.length > 0) \{\
    copy(textToCopy);\
    console.log('\uc0\u9989  \'a1SE COPIARON EXACTAMENTE ' + results.length + ' ARCHIVOS AL PORTAPAPELES!\\n\\n' + textToCopy);\
  \} else \{\
    console.error('\uc0\u10060  No se encontraron im\'e1genes en el contenedor.');\
  \}\
\})();\
